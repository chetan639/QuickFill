{
  "manifest_version": 3,
  "name": "QuickFill Snippets",
  "version": "1.0",
  "description": "Autofill saved text snippets using a '--' shortcut.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}